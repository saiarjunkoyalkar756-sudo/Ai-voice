# Voicely Platform — Environment Configuration
# Copy this file to .env and fill all required values.
# NEVER commit .env to git. Use a secrets manager for production.

# ── Core Identity ─────────────────────────────────────────────────────────────
CLIENT_ID=your-client-id
ENVIRONMENT=production

# ── Security (REQUIRED — must set before starting) ────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
API_SETTINGS_PASSWORD=
DISABLE_AUTH=false
ALLOWED_ORIGINS=https://yourdomain.com

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=speaksy-platform-control

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_REGION=asia-south1
GEMINI_CONTEXT_CACHE=1
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── STT ───────────────────────────────────────────────────────────────────────
STT_PROVIDER=soniox
SONIOX_API_KEY=
SARVAM_API_KEY=
DEEPGRAM_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
SARVAM_LLM_API_KEY=

# ── Supabase / Database ───────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=public
SUPABASE_BUCKET=call-recordings
SUPABASE_RECORDINGS_BUCKET=call-recordings
# SECURITY (CRITICAL-1): Bucket MUST be PRIVATE. Signed URLs only.
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
PLATFORM_REDIS_URL=redis://127.0.0.1:6383/0

# ── Telephony / SIP ───────────────────────────────────────────────────────────
SIP_TRUNK_ID=
OUTBOUND_TRUNK_ID=
INBOUND_PHONE_NUMBERS=
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX
SIP_DISPATCH_RULE_ID=
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_OUTBOUND_NUMBER=
VOBIZ_TRUNK_ID=
VOBIZ_INBOUND_TRUNK_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=baileys
WHATSAPP_SERVICE_URL=http://whatsapp-service:4001
WHATSAPP_HTTP_PORT=4010
WHATSAPP_API_URL=
# SECURITY (HIGH-6): HMAC-SHA256 webhook authentication secret
WHATSAPP_INTERNAL_SECRET=

# ── Calendar / CRM ────────────────────────────────────────────────────────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CRM_TYPE=twenty
CRM_API_KEY=
CRM_BASE_URL=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

# ── Speaker Profiling (optional) ──────────────────────────────────────────────
FISH_AUDIO_API_KEY=
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_TTS_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=
SMALLEST_API_KEY=
INWORLD_API_KEY=
GOOGLE_API_KEY=

# ── Security — KB Compiler SSRF Protection (CRITICAL-10) ─────────────────────
# Comma-separated allowed domains for knowledge_sources URL fetching.
# Leave empty to allow all public URLs (dev only). Set in production!
KB_ALLOWED_DOMAINS=

# ── Platform / Infra ──────────────────────────────────────────────────────────
VOICELY_CLIENTS_DIR=/opt/speaksy/clients
VOICELY_REGISTRY_DIR=/opt/speaksy/registry
VOICELY_BLUEPRINTS_DIR=/opt/speaksy/platform/speaksy-platform/blueprints
PLATFORM_PUBLIC_URL=https://platform.speaksy.online
TESTS_PUBLIC_URL=https://tests.speaksy.online
COMPOSE_PROJECT_NAME=speaksy-platform
CLIENT_HTTP_PORT=8002

# ── Agent Settings ────────────────────────────────────────────────────────────
LANG_PRESET=english
PSTN_LATENCY_ESTIMATE_MS=300
LIVEKIT_TTS_AGGRESSIVE_CHUNKING=1
SPEAKER_PROFILING_ENABLED=false
VOICELY_IQ_V2=1
VOICELY_INFRA_TOUCH=0
RE_MEMORY_DIR=~/.hermes/speaksy
DEFAULT_AGENT_ID=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NOTIFY_EMAIL=
AGENT_NOTIFICATION_URL=
